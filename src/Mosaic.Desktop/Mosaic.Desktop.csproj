<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Avalonia.props defaults this to true and AvaloniaBuildTasks.targets to false, so without this line
         a change in import order would drop every binding back to reflection without a warning. -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <!-- brings FluentIcons.Common at the exact version it needs; a direct reference could go lower without a warning -->
    <PackageReference Include="FluentIcons.Avalonia" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- NavBuilder is internal so pro cannot call it; the tests check it and the internal design data -->
    <InternalsVisibleTo Include="Mosaic.Desktop.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Contracts and nothing else, so the desktop cannot call Domain or Application code. -->
    <ProjectReference Include="..\Mosaic.Contracts\Mosaic.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- WithCulture=false, otherwise the SDK treats Strings.de.json as a satellite resource for "de". -->
    <EmbeddedResource Include="Localization\*.json" WithCulture="false" />
    <!-- .ico is not listed: Mosaic.Desktop.App points ApplicationIcon straight at the file. -->
    <AvaloniaResource Include="Assets\*.png" />
    <!-- Noto is the Arabic fallback for Inter, see DesktopHost.cs. Cascadia Mono is MonoFont in Atelier.axaml. -->
    <AvaloniaResource Include="Assets\Fonts\*.ttf" />
    <!-- OFL wants the licence text shipped with the fonts. The ttf files are inside the assembly, so copy the file next to the exe. -->
    <Content Include="Assets\Fonts\OFL.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
