<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- NU1608: FluentIcons.Avalonia wants Common 2.1.339 exactly and we override it, see Directory.Packages.props -->
    <NoWarn>$(NoWarn);NU1608</NoWarn>
    <!-- Avalonia.props defaults this to true and AvaloniaBuildTasks.targets to false. Left unsaid, a
         change in import order would silently drop every binding back to reflection. -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="FluentIcons.Avalonia" />
    <PackageReference Include="FluentIcons.Common" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- NavBuilder is internal so pro cannot call it, but its rules are what the tests check -->
    <InternalsVisibleTo Include="Mosaic.Desktop.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Contracts and nothing else: the desktop computes no business fact, and this line enforces it. -->
    <ProjectReference Include="..\Mosaic.Contracts\Mosaic.Contracts.csproj" />
  </ItemGroup>

  <!-- breaks the build on a FluentIcons bump so the Common override gets re-checked -->
  <Target Name="FluentIconsOverrideStillNeeded" BeforeTargets="Build">
    <Error Condition="'$(FluentIconsVersion)' != '2.1.339'"
           Text="FluentIcons moved off 2.1.339. Check whether FluentIcons.Common still throws from its static initializer on .NET 10. If it is fixed, drop the .1 suffix on its PackageVersion and the NU1608 suppression above." />
  </Target>

  <ItemGroup>
    <!-- WithCulture=false, otherwise the SDK treats Strings.de.json as a satellite resource for "de". -->
    <EmbeddedResource Include="Localization\*.json" WithCulture="false" />
    <!-- .ico is not listed: Mosaic.Desktop.App points ApplicationIcon straight at the file. -->
    <AvaloniaResource Include="Assets\*.png" />
    <!-- Arabic fallback for Inter, see DesktopHost.cs. -->
    <AvaloniaResource Include="Assets\Fonts\*.ttf" />
    <!-- OFL wants the licence text shipped with the font. The ttf is inside the assembly, so copy the file next to the exe. -->
    <Content Include="Assets\Fonts\OFL.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
