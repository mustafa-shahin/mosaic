<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:health="using:Mosaic.Desktop.Features.Health"
             xmlns:settings="using:Mosaic.Desktop.Features.Settings"
             xmlns:shell="using:Mosaic.Desktop.Shell"
             xmlns:start="using:Mosaic.Desktop.Shell.Start"
             xmlns:firstrun="using:Mosaic.Desktop.Shell.FirstRun"
             xmlns:signin="using:Mosaic.Desktop.Shell.SignIn"
             x:Class="Mosaic.Desktop.App"
             RequestedThemeVariant="Default">
             <!-- Overwritten at startup from settings. -->

    <!-- no ViewLocator on purpose, this way a missing view is a compile error -->
    <Application.DataTemplates>
        <!-- the screens the window and the shell switch between -->
        <DataTemplate DataType="start:StartViewModel">
            <start:StartView />
        </DataTemplate>
        <DataTemplate DataType="firstrun:FirstRunViewModel">
            <firstrun:FirstRunView />
        </DataTemplate>
        <DataTemplate DataType="signin:SignInViewModel">
            <signin:SignInView />
        </DataTemplate>
        <DataTemplate DataType="shell:ShellViewModel">
            <shell:ShellView />
        </DataTemplate>
        <DataTemplate DataType="health:HealthViewModel">
            <health:HealthView />
        </DataTemplate>
        <DataTemplate DataType="settings:SettingsViewModel">
            <settings:SettingsView />
        </DataTemplate>
        <!-- the shell's own screen, a single text block, so it has no view file of its own -->
        <DataTemplate DataType="shell:NoAccessViewModel">
            <SelectableTextBlock Classes="body" Text="{Binding Message}" TextWrapping="Wrap" MaxWidth="480" />
        </DataTemplate>
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Mosaic.Desktop/Themes/Atelier.axaml" />
                <ResourceInclude Source="avares://Mosaic.Desktop/Themes/Components.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Mosaic.Desktop/Themes/Controls.axaml" />
    </Application.Styles>
</Application>
