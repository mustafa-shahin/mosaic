<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="using:Mosaic.Desktop.Controls"
                    xmlns:fi="using:FluentIcons.Avalonia">

    <ControlTheme x:Key="{x:Type c:Card}" TargetType="c:Card">
        <Setter Property="Background" Value="{DynamicResource SurfaceCard}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HairlineFaint}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource CardRadius}" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}"
                        BoxShadow="{DynamicResource CardShadow}">
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Top" Spacing="3" Margin="0,0,0,14">
                            <SelectableTextBlock Classes="cardTitle" Text="{TemplateBinding Title}" />
                            <SelectableTextBlock Classes="note" Text="{TemplateBinding Subtitle}"
                                                 IsVisible="{Binding Subtitle, RelativeSource={RelativeSource TemplatedParent},
                                                 Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </DockPanel>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type c:ErrorBox}" TargetType="c:ErrorBox">
        <Setter Property="Template">
            <ControlTemplate>
                <Border CornerRadius="{DynamicResource ControlRadius}" Padding="12"
                        Background="{DynamicResource StatusBadSoft}"
                        BorderBrush="{DynamicResource StatusBad}" BorderThickness="1">
                    <DockPanel>
                        <Ellipse DockPanel.Dock="Left" Width="6" Height="6" Margin="0,6,10,0" VerticalAlignment="Top"
                                 Fill="{DynamicResource StatusBad}" />
                        <SelectableTextBlock Text="{TemplateBinding Text}" FontSize="{DynamicResource NoteSize}"
                                             TextWrapping="Wrap" />
                    </DockPanel>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!-- centred where the content would be: an icon in a thin frame, a title, one sentence, and the button when there is one -->
    <ControlTheme x:Key="{x:Type c:StateMessage}" TargetType="c:StateMessage">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="MaxWidth" Value="420" />
        <Setter Property="Padding" Value="24,48" />
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel Margin="{TemplateBinding Padding}" Spacing="14">
                    <Border Width="40" Height="40" HorizontalAlignment="Center"
                            CornerRadius="{DynamicResource ControlRadius}"
                            BorderBrush="{DynamicResource HairlineSoft}" BorderThickness="1">
                        <fi:SymbolIcon Symbol="{TemplateBinding Icon}" FontSize="18"
                                       Foreground="{DynamicResource TextMuted}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Classes="cardTitle" TextAlignment="Center" TextWrapping="Wrap" Text="{TemplateBinding Title}" />
                    <TextBlock Classes="body secondary" TextAlignment="Center" TextWrapping="Wrap" Text="{TemplateBinding Text}" />
                    <ContentPresenter HorizontalAlignment="Center" Margin="0,4,0,0"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      IsVisible="{Binding Content, RelativeSource={RelativeSource TemplatedParent},
                                      Converter={x:Static ObjectConverters.IsNotNull}}" />
                </StackPanel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type c:StatusPill}" TargetType="c:StatusPill">
        <Setter Property="Height" Value="22" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Foreground" Value="{DynamicResource StatusInfo}" />
        <Setter Property="Background" Value="{DynamicResource StatusInfoSoft}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        CornerRadius="{DynamicResource PillRadius}" Padding="10,0">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Ellipse Width="5" Height="5" VerticalAlignment="Center"
                                 Fill="{TemplateBinding Foreground}" />
                        <TextBlock Classes="caption" VerticalAlignment="Center"
                                   Foreground="{TemplateBinding Foreground}"
                                   Text="{TemplateBinding Text}" />
                    </StackPanel>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!-- a filled circle with initials, or a dashed empty one when there are none -->
    <ControlTheme x:Key="{x:Type c:PersonBadge}" TargetType="c:PersonBadge">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Ellipse Stroke="{DynamicResource TextMuted}" StrokeThickness="1" StrokeDashArray="2,2"
                             IsVisible="{Binding Initials, RelativeSource={RelativeSource TemplatedParent},
                             Converter={x:Static StringConverters.IsNullOrEmpty}}" />
                    <Border CornerRadius="{DynamicResource PillRadius}"
                            Background="{DynamicResource SurfaceHover}"
                            BorderBrush="{DynamicResource HairlineSoft}" BorderThickness="1"
                            IsVisible="{Binding Initials, RelativeSource={RelativeSource TemplatedParent},
                            Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Text="{TemplateBinding Initials}" FontSize="9" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondary}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Panel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!-- a quiet icon button with two icons on the same spot; the check mark shows only for a moment after a copy -->
    <ControlTheme x:Key="{x:Type c:CopyButton}" TargetType="c:CopyButton">
        <Setter Property="Template">
            <ControlTemplate>
                <Button Classes="icon quiet">
                    <Panel>
                        <fi:SymbolIcon Name="CopyIcon" Symbol="Copy" FontSize="16" />
                        <fi:SymbolIcon Name="DoneIcon" Symbol="Checkmark" FontSize="16"
                                       Foreground="{DynamicResource StatusOk}" />
                    </Panel>
                </Button>
            </ControlTemplate>
        </Setter>

        <Style Selector="^ /template/ fi|SymbolIcon#DoneIcon">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <Style Selector="^:copied /template/ fi|SymbolIcon#CopyIcon">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <Style Selector="^:copied /template/ fi|SymbolIcon#DoneIcon">
            <Setter Property="IsVisible" Value="True" />
        </Style>
    </ControlTheme>

    <!-- the foot of a list: a summary, then Previous and Next around the position or around the page numbers; a button is switched off at its end of the list -->
    <ControlTheme x:Key="{x:Type c:Pager}" TargetType="c:Pager">
        <Setter Property="Height" Value="{DynamicResource HeaderHeight}" />
        <Setter Property="Padding" Value="24,0" />
        <Setter Property="BorderBrush" Value="{DynamicResource HairlineSoft}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Padding="{TemplateBinding Padding}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <Button Name="PART_Previous" Classes="secondary" Content="{TemplateBinding PreviousText}" />
                            <TextBlock Name="PART_Position" Classes="note" VerticalAlignment="Center" Text="{TemplateBinding Position}" />
                            <ItemsControl Name="PART_Numbers" ItemsSource="{TemplateBinding Slots}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="c:PageSlot">
                                        <Panel>
                                            <Button Classes="secondary pageNumber" Classes.current="{Binding IsCurrent}"
                                                    Content="{Binding Number}" IsVisible="{Binding !IsGap}" />
                                            <TextBlock Classes="note pageGap" Text="…" IsVisible="{Binding IsGap}" />
                                        </Panel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Name="PART_Next" Classes="secondary" Content="{TemplateBinding NextText}" />
                        </StackPanel>
                        <TextBlock Classes="note" VerticalAlignment="Center" Text="{TemplateBinding Summary}" />
                    </DockPanel>
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:first /template/ Button#PART_Previous">
            <Setter Property="IsEnabled" Value="False" />
        </Style>

        <Style Selector="^:last /template/ Button#PART_Next">
            <Setter Property="IsEnabled" Value="False" />
        </Style>

        <!-- the two modes share one template: each hides the part of the other -->
        <Style Selector="^ /template/ ItemsControl#PART_Numbers">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <Style Selector="^[Mode=Numbers] /template/ ItemsControl#PART_Numbers">
            <Setter Property="IsVisible" Value="True" />
        </Style>

        <Style Selector="^[Mode=Numbers] /template/ TextBlock#PART_Position">
            <Setter Property="IsVisible" Value="False" />
        </Style>
    </ControlTheme>

    <!-- the container around one table row: no padding and no colour of its own, so the row lines up with its column names -->
    <ControlTheme x:Key="TableRowItem" TargetType="ListBoxItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Background="{TemplateBinding Background}"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}" />
                    <!-- drawn over the row, so the edge of a selected row takes no room and nothing moves -->
                    <Border Name="Edge" BorderThickness="1" IsHitTestVisible="False" />
                </Panel>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
        </Style>

        <Style Selector="^:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
        </Style>

        <Style Selector="^:selected /template/ Border#Edge">
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
        </Style>
    </ControlTheme>

    <!-- the ComboBox's own theme, with the label written before the chosen value inside the closed box -->
    <ControlTheme x:Key="{x:Type c:FilterBox}" TargetType="c:FilterBox" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="SelectionBoxItemTemplate">
            <DataTemplate x:DataType="x:Object">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Classes="quiet" VerticalAlignment="Center" Text="{Binding $parent[c:FilterBox].Label}" />
                    <ContentPresenter Classes="filterValue" VerticalAlignment="Center"
                                      Content="{Binding $parent[c:FilterBox].SelectionBoxItem}"
                                      ContentTemplate="{Binding $parent[c:FilterBox].ItemTemplate}" />
                </StackPanel>
            </DataTemplate>
        </Setter>
    </ControlTheme>

    <!-- one choice of a segmented list: rounded inside the list's frame, filled while it is the chosen one -->
    <ControlTheme x:Key="SegmentItem" TargetType="ListBoxItem">
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlRadius}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate>
                <ContentPresenter Name="PART_ContentPresenter"
                                  Background="{TemplateBinding Background}"
                                  CornerRadius="{TemplateBinding CornerRadius}"
                                  Padding="{TemplateBinding Padding}"
                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}" />
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
        </Style>

        <Style Selector="^:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
        </Style>
    </ControlTheme>

    <!-- 2x2 tiles, 13 wide with a 2 gutter, on a 32 grid, as in mosaic-256.png -->
    <ControlTheme x:Key="{x:Type c:MosaicMark}" TargetType="c:MosaicMark">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Template">
            <ControlTemplate>
                <Viewbox Stretch="Uniform">
                    <Canvas Width="32" Height="32">
                        <Border Canvas.Left="2" Canvas.Top="2" Width="13" Height="13" CornerRadius="3"
                                Background="{DynamicResource Accent}" />
                        <Border Canvas.Left="17" Canvas.Top="2" Width="13" Height="13" CornerRadius="3"
                                Background="{DynamicResource AccentHover}" Opacity="0.75" />
                        <Border Canvas.Left="2" Canvas.Top="17" Width="13" Height="13" CornerRadius="3"
                                Background="{DynamicResource AccentHover}" Opacity="0.6" />
                        <Border Canvas.Left="17" Canvas.Top="17" Width="13" Height="13" CornerRadius="3"
                                Background="{DynamicResource Accent}" Opacity="0.85" />
                    </Canvas>
                </Viewbox>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type c:FactRow}" TargetType="c:FactRow">
        <Setter Property="Height" Value="{DynamicResource RowHeight}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border BorderBrush="{DynamicResource HairlineFaint}"
                        BorderThickness="0,0,0,1"
                        Name="Separator">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{DynamicResource FactLabelWidth}" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Classes="note secondary" VerticalAlignment="Center"
                                   Text="{TemplateBinding Label}" />
                        <SelectableTextBlock Grid.Column="1" Classes="value" VerticalAlignment="Center"
                                             Text="{TemplateBinding Value}" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

</ResourceDictionary>
