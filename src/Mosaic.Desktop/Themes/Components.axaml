<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="using:Mosaic.Desktop.Controls">

  <ControlTheme x:Key="{x:Type c:Card}" TargetType="c:Card">
    <Setter Property="Background" Value="{DynamicResource SurfaceCard}" />
    <Setter Property="BorderBrush" Value="{DynamicResource HairlineFaint}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource CardRadius}" />
    <Setter Property="Padding" Value="20" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}"
                BoxShadow="{DynamicResource CardShadow}">
          <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Top" Spacing="3" Margin="0,0,0,14">
              <SelectableTextBlock Classes="cardTitle" Text="{TemplateBinding Title}" />
              <SelectableTextBlock Classes="note" Text="{TemplateBinding Subtitle}"
                                   IsVisible="{Binding Subtitle, RelativeSource={RelativeSource TemplatedParent},
                                                       Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}" />
          </DockPanel>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type c:ErrorBox}" TargetType="c:ErrorBox">
    <Setter Property="Template">
      <ControlTemplate>
        <Border CornerRadius="{DynamicResource ControlRadius}" Padding="12"
                Background="{DynamicResource StatusBadSoft}"
                BorderBrush="{DynamicResource StatusBad}" BorderThickness="1">
          <DockPanel>
            <Ellipse DockPanel.Dock="Left" Width="6" Height="6" Margin="0,6,10,0" VerticalAlignment="Top"
                     Fill="{DynamicResource StatusBad}" />
            <SelectableTextBlock Text="{TemplateBinding Text}" FontSize="{DynamicResource NoteSize}"
                                 TextWrapping="Wrap" />
          </DockPanel>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type c:StatusPill}" TargetType="c:StatusPill">
    <Setter Property="Height" Value="22" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Foreground" Value="{DynamicResource StatusInfo}" />
    <Setter Property="Background" Value="{DynamicResource StatusInfoSoft}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                CornerRadius="{DynamicResource PillRadius}" Padding="10,0">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Ellipse Width="5" Height="5" VerticalAlignment="Center"
                     Fill="{TemplateBinding Foreground}" />
            <TextBlock Classes="caption" VerticalAlignment="Center"
                       Foreground="{TemplateBinding Foreground}"
                       Text="{TemplateBinding Text}" />
          </StackPanel>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- 2x2 tiles, 13 wide with a 2 gutter, on a 32 grid, as in mosaic-256.png -->
  <ControlTheme x:Key="{x:Type c:MosaicMark}" TargetType="c:MosaicMark">
    <Setter Property="Width" Value="26" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Template">
      <ControlTemplate>
        <Viewbox Stretch="Uniform">
          <Canvas Width="32" Height="32">
            <Border Canvas.Left="2" Canvas.Top="2" Width="13" Height="13" CornerRadius="3"
                    Background="{DynamicResource Accent}" />
            <Border Canvas.Left="17" Canvas.Top="2" Width="13" Height="13" CornerRadius="3"
                    Background="{DynamicResource AccentHover}" Opacity="0.75" />
            <Border Canvas.Left="2" Canvas.Top="17" Width="13" Height="13" CornerRadius="3"
                    Background="{DynamicResource AccentHover}" Opacity="0.6" />
            <Border Canvas.Left="17" Canvas.Top="17" Width="13" Height="13" CornerRadius="3"
                    Background="{DynamicResource Accent}" Opacity="0.85" />
          </Canvas>
        </Viewbox>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type c:FactRow}" TargetType="c:FactRow">
    <Setter Property="Height" Value="{DynamicResource RowHeight}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border BorderBrush="{DynamicResource HairlineFaint}"
                BorderThickness="0,0,0,1"
                Name="Separator">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="{DynamicResource FactLabelWidth}" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Classes="note secondary" VerticalAlignment="Center"
                       Text="{TemplateBinding Label}" />
            <SelectableTextBlock Grid.Column="1" Classes="value" VerticalAlignment="Center"
                                 Text="{TemplateBinding Value}" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

</ResourceDictionary>
