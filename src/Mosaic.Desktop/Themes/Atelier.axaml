<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Dark/Light only pick the palette, everything below is shared -->

  <ResourceDictionary.ThemeDictionaries>

    <ResourceDictionary x:Key="Dark">
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Mosaic.Desktop/Themes/Palettes/AtelierNight.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>

    <ResourceDictionary x:Key="Light">
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Mosaic.Desktop/Themes/Palettes/AtelierDay.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>

  </ResourceDictionary.ThemeDictionaries>

  <x:Double x:Key="HeaderHeight">64</x:Double>
  <x:Double x:Key="RowHeight">44</x:Double>
  <x:Double x:Key="NavRowHeight">34</x:Double>
  <x:Double x:Key="ContentColumnWidth">560</x:Double>
  <!-- Fixed, not Auto. Every FactRow is its own Grid and Avalonia has no SharedSizeGroup, so Auto would
       size each row to its own label and the values would stop lining up down the column. -->
  <GridLength x:Key="FactLabelWidth">150</GridLength>

  <CornerRadius x:Key="CardRadius">12</CornerRadius>
  <CornerRadius x:Key="ControlRadius">8</CornerRadius>
  <CornerRadius x:Key="PillRadius">999</CornerRadius>

  <FontFamily x:Key="TextFont">Inter</FontFamily>

  <x:Double x:Key="TitleSize">22</x:Double>
  <x:Double x:Key="CardTitleSize">17</x:Double>
  <x:Double x:Key="BodySize">14</x:Double>
  <x:Double x:Key="NoteSize">13</x:Double>
  <x:Double x:Key="CaptionSize">11.5</x:Double>

</ResourceDictionary>
