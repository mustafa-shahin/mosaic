<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:shell="using:Mosaic.Desktop.Shell"
             xmlns:nav="using:Mosaic.Desktop.Shell.Navigation"
             xmlns:fi="using:FluentIcons.Avalonia"
             xmlns:c="using:Mosaic.Desktop.Controls"
             x:Class="Mosaic.Desktop.Shell.SidebarView"
             x:DataType="shell:ShellViewModel"
             Name="Root"
             mc:Ignorable="d" d:DesignWidth="264" d:DesignHeight="600"
             Design.DataContext="{x:Static shell:ShellDesignData.Default}">

  <Border Background="{DynamicResource SurfaceSidebar}"
          BorderBrush="{DynamicResource HairlineFaint}"
          BorderThickness="0,0,1,0"
          Padding="12,18,12,12">

    <DockPanel LastChildFill="False">

      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="8,0,8,18">
        <c:MosaicMark VerticalAlignment="Center" />
        <TextBlock Text="Mosaic" FontSize="17" FontWeight="SemiBold"
                   LetterSpacing="-0.2" VerticalAlignment="Center" />
      </StackPanel>

      <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Sections}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="nav:NavSection">
            <StackPanel Spacing="2">
              <TextBlock Classes="caption" Text="{Binding Caption}" Margin="10,12,10,6" />
              <ItemsControl ItemsSource="{Binding Entries}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="nav:NavEntry">
                    <Panel Margin="0,0,0,2">
                      <Button Classes="nav"
                              Classes.active="{Binding IsActive}"
                              Command="{Binding #Root.((shell:ShellViewModel)DataContext).GoCommand}"
                              CommandParameter="{Binding}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                          <fi:SymbolIcon Symbol="{Binding Icon}" FontSize="16" VerticalAlignment="Center" />
                          <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                        </StackPanel>
                      </Button>
                      <Border Width="3" Height="22" CornerRadius="0,2,2,0"
                              HorizontalAlignment="Left" VerticalAlignment="Center"
                              Background="{DynamicResource Accent}"
                              IsVisible="{Binding IsActive}"
                              IsHitTestVisible="False" />
                    </Panel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- the account chip; its menu opens upwards because the chip sits at the bottom -->
      <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource HairlineFaint}" BorderThickness="0,1,0,0"
              Padding="0,10,0,0">
        <Button Name="AccountButton" Classes="account" AutomationProperties.Name="{Binding Name}">
          <Button.Flyout>
            <MenuFlyout Placement="TopEdgeAlignedLeft">
              <MenuItem Header="{Binding Strings[shell.sign_out]}" Command="{Binding SignOutHereCommand}" />
            </MenuFlyout>
          </Button.Flyout>
          <DockPanel>
            <Border DockPanel.Dock="Left" Classes="initials">
              <TextBlock Text="{Binding Initials}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Margin="10,0,0,0" Spacing="1" VerticalAlignment="Center">
              <TextBlock Classes="accountName" Text="{Binding Name}" />
              <TextBlock Classes="accountEmail" Text="{Binding Email}" />
            </StackPanel>
          </DockPanel>
        </Button>
      </Border>

    </DockPanel>
  </Border>
</UserControl>
