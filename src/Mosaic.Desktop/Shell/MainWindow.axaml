<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="using:Mosaic.Desktop.Shell"
        x:Class="Mosaic.Desktop.Shell.MainWindow"
        x:DataType="shell:MainWindowViewModel"
        Title="{Binding Strings[app.title]}"
        Icon="/Assets/mosaic-256.png"
        FlowDirection="{Binding Strings.FlowDirection}"
        Background="{DynamicResource SurfaceWindow}"
        Width="1360" Height="848"
        MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen">

  <ContentControl Content="{Binding Current}" />

</Window>
