<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Mosaic.Desktop.Features.Health"
             xmlns:c="using:Mosaic.Desktop.Controls"
             x:Class="Mosaic.Desktop.Features.Health.HealthView"
             x:DataType="vm:HealthViewModel"
             mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="460"
             Design.DataContext="{x:Static vm:HealthDesignData.Reachable}">

  <c:Card Title="{Binding Strings[health.title]}"
          Subtitle="{Binding Strings[health.subtitle]}"
          Width="{DynamicResource ContentColumnWidth}" HorizontalAlignment="Left">

    <StackPanel Spacing="14">

      <c:StatusPill Level="{Binding Status}" Text="{Binding StatusText}"
                    HorizontalAlignment="Left" />

      <Border IsVisible="{Binding IsUnreachable}"
              CornerRadius="8" Padding="14"
              Background="{DynamicResource StatusBadSoft}"
              BorderBrush="{DynamicResource StatusBad}" BorderThickness="1">
        <SelectableTextBlock Classes="body" Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
      </Border>

      <Border IsVisible="{Binding IsIncompatible}"
              CornerRadius="8" Padding="14"
              Background="{DynamicResource StatusWarnSoft}"
              BorderBrush="{DynamicResource StatusWarn}" BorderThickness="1">
        <SelectableTextBlock Classes="body" Text="{Binding ContractSummary}" TextWrapping="Wrap" />
      </Border>

      <Border Classes="sunk" IsVisible="{Binding IsReachable}">
        <StackPanel>
          <c:FactRow Label="{Binding Strings[health.service]}" Value="{Binding Service}" />
          <c:FactRow Label="{Binding Strings[health.server_time]}" Value="{Binding ServerTimeUtc}"
                     IsLast="True" />
        </StackPanel>
      </Border>

      <Button Classes="secondary"
              HorizontalAlignment="Left"
              Content="{Binding Strings[health.check_again]}"
              Command="{Binding CheckCommand}" />

    </StackPanel>
  </c:Card>
</UserControl>
